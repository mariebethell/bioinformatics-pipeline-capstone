version = "0.0.1"
url = "https://github.com/mariebethell/bioinformatics-pipeline-capstone"
license.file = "LICENSE"
author = "CSUSM-CSE-47-2026-CS-S03-Team-002"
author_email = "lopez2349@csusm.edu"

[tool.briefcase.app.nodepipe]
formal_name = "NodePipe"
description = "Visual editor and executor for bioinformatics pipelines using NextFlow"
