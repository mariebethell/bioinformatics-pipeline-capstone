/*
 * Auto-generated nf-core module overrides.
 * Each block is compiled from a normalized pipeline node.
 */

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC1' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRIMMOMATIC' {
        ext.args2 = 'LEADING:3 TRAILING:3 SLIDINGWINDOW:4:20 MINLEN:36'
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/trimmomatic" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQC2' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
