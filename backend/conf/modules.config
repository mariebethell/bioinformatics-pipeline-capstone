/*
Proccess level overides for the nf-core modules 


*/


process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
     * -------------------------
     * Quality control
     * -------------------------
     */

    withName: 'FASTQC_RAW' {
        ext.args = {
            [
                params.fastqc_raw_quiet ? '--quiet' : '',
                params.fastqc_raw_nogroup ? '--nogroup' : '',
                params.fastqc_raw_kmers ? "--kmers ${params.fastqc_raw_kmers}" : '',
                params.fastqc_raw_adapters ? "--adapters ${params.fastqc_raw_adapters}" : '',
                params.fastqc_raw_contaminants ? "--contaminants ${params.fastqc_raw_contaminants}" : '',
                params.fastqc_raw_limits ? "--limits ${params.fastqc_raw_limits}" : '',
                params.fastqc_raw_format ? "--format ${params.fastqc_raw_format}" : '',
                params.fastqc_raw_extract ? '--extract' : '',
                params.fastqc_raw_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/fastqc_raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQC_TRIM' {
        ext.args = {
            [
                params.fastqc_trim_quiet ? '--quiet' : '',
                params.fastqc_trim_nogroup ? '--nogroup' : '',
                params.fastqc_trim_kmers ? "--kmers ${params.fastqc_trim_kmers}" : '',
                params.fastqc_trim_adapters ? "--adapters ${params.fastqc_trim_adapters}" : '',
                params.fastqc_trim_contaminants ? "--contaminants ${params.fastqc_trim_contaminants}" : '',
                params.fastqc_trim_limits ? "--limits ${params.fastqc_trim_limits}" : '',
                params.fastqc_trim_format ? "--format ${params.fastqc_trim_format}" : '',
                params.fastqc_trim_extract ? '--extract' : '',
                params.fastqc_trim_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/fastqc_trim" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
     * -------------------------
     * Read trimming
     * -------------------------
     * Trimmomatic module behavior:
     * - mode (SE/PE) comes from meta.single_end
     * - threads come from task.cpus
     * - trimlog and summary are managed by the module
     */

    withName: 'TRIMMOMATIC_TRIM' {
        ext.args2 = {
            [
                params.trimmomatic_trim_steps ?: ''
            ].findAll { it }.join(' ')
        }

        ext.args = {
            [
                params.trimmomatic_trim_phred ? "-phred${params.trimmomatic_trim_phred}" : '',
                params.trimmomatic_trim_validate_pairs ? '-validatePairs' : '',
                params.trimmomatic_trim_compress_level ? "-compressLevel ${params.trimmomatic_trim_compress_level}" : '',
                params.trimmomatic_trim_compression_mode == 'stream' ? '-compressStream' : '',
                params.trimmomatic_trim_compression_mode == 'block' ? '-compressBlock' : '',
                params.trimmomatic_trim_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/trimmomatic_trim" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
     * -------------------------
     * Assembly
     * -------------------------
     * Trinity module behavior:
     */

    withName: 'TRINITY_ASSEMBLY' {
        ext.args = {
            [
                params.trinity_assembly_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/trinity_assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
     * -------------------------
     * SAMtools
     * Professor-requested priorities: cat, maybe fastq
     * -------------------------
     */

    withName: 'SAMTOOLS_CAT' {
        ext.args = {
            [
                params.samtools_cat_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/samtools_cat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_FASTQ' {
        ext.args = {
            [
                params.samtools_fastq_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/samtools_fastq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
     * -------------------------
     * Alignment
     * -------------------------
     */

    withName: 'HISAT2_BUILD' {
        ext.args = {
            [
                params.hisat2_build_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        publishDir = [
            path: { "${params.outdir}/hisat2_build" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HISAT2_ALIGN' {
        ext.args = {
            [
                params.hisat2_align_dta ? '--dta' : '',
                params.hisat2_align_no_spliced_alignment ? '--no-spliced-alignment' : '',
                params.hisat2_align_k ? "-k ${params.hisat2_align_k}" : '',
                params.hisat2_align_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/hisat2_align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
     * -------------------------
     * Quantification
     * -------------------------
     */

    withName: 'SALMON_INDEX_TRANSCRIPTOME' {
        ext.args = {
            [
                params.salmon_index_transcriptome_k ? "-k ${params.salmon_index_transcriptome_k}" : '',
                params.salmon_index_transcriptome_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        publishDir = [
            path: { "${params.outdir}/salmon_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SALMON_QUANT_TRANSCRIPTOME' {
        ext.args = {
            [
                params.salmon_quant_transcriptome_gc_bias ? '--gcBias' : '',
                params.salmon_quant_transcriptome_validate ? '--validateMappings' : '',
                params.salmon_quant_transcriptome_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/salmon_quant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
     * -------------------------
     * Differential expression
     * -------------------------
     */

    withName: 'DESEQ2_DIFFERENTIAL' {
        ext.args = {
            [
                params.deseq2_differential_extra_args ?: ''
            ].findAll { it }.join(' ')
        }

        publishDir = [
            path: { "${params.outdir}/deseq2_differential" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
